{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaremo",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/file/*",
      "/mcp",
      "/openapi.json",
      "/memos.api.v1.*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaremo",
      "database_id": "6ea0cf2f-505d-4646-a44c-40cb8bfcab3d",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "flaremo-attachments"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "FLAREMO_DEPLOY_REPOSITORY": "BaiRuic/FlareMo",
    "FLAREMO_SINGLE_USER_EMAIL": "owner@flaremo.local",
    "FLAREMO_SINGLE_USER_NAME": "FlareMo Owner",
    // Canonical origin used by Better Auth for callback and cookie checks.
    // Set this to the deployed origin; keep secrets out of this file.
    "FLAREMO_PUBLIC_URL": "https://flaremo.brc730.workers.dev",
    // Optional comma-separated additional browser origins for trusted clients.
    "FLAREMO_TRUSTED_ORIGINS": ""
  }
}
